# Dev X Music 🎶 — Environment Variables
# Copy this file to .env and fill in your values

# ── From my.telegram.org/apps ──
API_ID=
API_HASH=

# ── From @BotFather on Telegram ──
BOT_TOKEN=

# ── MongoDB from cloud.mongodb.com ──
MONGO_URL=

# ── Logger Group / Channel ID ──
LOGGER_ID=

# ── Owner Telegram User ID ──
OWNER_ID=

# ── Pyrogram Session from @StringFatherBot ──
SESSION=

# ── Optional ──
BOT_USERNAME=
DURATION_LIMIT=60
QUEUE_LIMIT=20
PLAYLIST_LIMIT=20
SUPPORT_CHANNEL=https://t.me/DevXMusic
SUPPORT_CHAT=https://t.me/DevXMusicChat
AUTO_LEAVE=False
AUTO_END=False
THUMB_GEN=True
VIDEO_PLAY=True
LANG_CODE=en
DEFAULT_THUMB=https://te.legra.ph/file/3e40a408286d4eda24191.jpg
PING_IMG=https://files.catbox.moe/haagg2.png
START_IMG=https://files.catbox.moe/zvziwk.jpg
